{
  "name": "split-commit",
  "version": "1.0.0",
  "description": "Conservatively classify working-tree changes as behavioral or provably mechanical refactors.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "split-commit": "./dist/src/cli/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leesj-dev/split-commit.git"
  },
  "bugs": {
    "url": "https://github.com/leesj-dev/split-commit/issues"
  },
  "homepage": "https://github.com/leesj-dev/split-commit#readme",
  "keywords": [
    "git",
    "refactoring",
    "commit",
    "typescript",
    "cli"
  ]
}
